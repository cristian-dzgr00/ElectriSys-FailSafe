# ElectriSys NLP Service - variables de entorno
# Se usan a partir de la Sprint 3 (NER: diccionario dinámico desde el backend)
# y la Sprint 5 (integración backend PHP <-> microservicio).

# URL del backend PHP para consultar catálogo/vehículos/compatibilidad
# BACKEND_URL=http://backend-a

# Clave compartida para autenticar llamadas internas backend -> microservicio
# NLP_INTERNAL_KEY=
