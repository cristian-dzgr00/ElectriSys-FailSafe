# ============================================================
# ElectriSys — secretos de docker-compose
#
# Docker Compose lee automáticamente el archivo "docker/.env" (junto al
# docker-compose.yml). Este .env.example es la plantilla versionada; el
# .env real está en .gitignore y NUNCA debe subirse al repositorio.
#
# Primer uso:
#     cp docker/.env.example docker/.env
#     # luego reemplazá cada valor por uno generado (ver comandos abajo)
#
# Antes estos secretos estaban escritos como valores por defecto dentro
# del propio docker-compose.yml, es decir, publicados en el repositorio:
# cualquiera que lo leyera podía firmar JWTs válidos para todo el sistema.
# ============================================================

# ── JWT ───────────────────────────────────────────────────────
# Lo comparten el backend PHP (firma y valida), el websocket-server
# (valida la conexión) y el nlp-service (firma su token de servicio).
# Los tres DEBEN tener el mismo valor o los tokens no se validan.
# Generar con:  openssl rand -base64 64
JWT_SECRET=CAMBIAR_openssl_rand_base64_64

# ── Clave interna: backend PHP -> websocket-server (/notify) ──
# Generar con:  openssl rand -hex 32
WS_NOTIFY_KEY=CAMBIAR_openssl_rand_hex_32

# ── Clave interna: backend PHP -> nlp-service (X-Internal-Key) ─
# Generar con:  openssl rand -hex 32
NLP_INTERNAL_KEY=CAMBIAR_openssl_rand_hex_32

# ── Oracle Database 23ai Free ───────────────────────────────────
# ORACLE_PASSWORD: password de SYS/SYSTEM (bootstrap de la imagen
# gvenzl/oracle-free). DB_PASS: password del usuario de aplicación
# "electrisys" (dueño del esquema — ver oracle/01_usuario_y_esquema.sql),
# también creado automáticamente por la imagen vía APP_USER_PASSWORD.
# Generar con:  openssl rand -base64 24
ORACLE_PASSWORD=CAMBIAR_password_sys_system
DB_PASS=CAMBIAR_password_electrisys

# ── Despliegue en producción ──────────────────────────────────
# Dominio público del POS (DuckDNS u otro). Lo usa el override
# docker/docker-compose.prod.yml para el FRONTEND_URL del backend (CORS).
# El mismo valor tiene que estar en nginx/nginx.prod.conf (server_name y
# rutas del certificado) — ver docs/despliegue-produccion.md.
DOMINIO=electrisys-pos.duckdns.org

# ── Respaldos automáticos (docker-compose.backup.yml) ─────────
# Poner en 1 para que el servicio oracle-backup corra un respaldo apenas
# levanta, en vez de esperar a las 2 AM. Útil para verificar un despliegue
# nuevo; dejar en 0 para la operación normal.
BACKUP_AL_ARRANCAR=0

# ── Grafana (stack de monitoreo) ──────────────────────────────
# Contraseña del usuario admin.
GRAFANA_PASSWORD=CAMBIAR_password_grafana
