FROM php:8.2-fpm-bookworm

# ── Dependencias del sistema ──────────────────────────────────
# Cambiado de php:8.2-fpm-alpine a esta imagen (Debian): el Oracle Instant
# Client solo tiene binarios oficiales para glibc, no para musl-libc de
# Alpine (ver oracle/docs/migracion-oracle.md — migración de MySQL a
# Oracle). Fijado a "bookworm" (Debian 12) explícitamente en vez del tag
# genérico "php:8.2-fpm": ese tag ya apunta a Debian 13 "trixie", que
# renombró el paquete libaio1 -> libaio1t64 con un SONAME distinto
# (libaio.so.1t64), y el Instant Client de Oracle busca libaio.so.1 a
# secas — se rompe el link en tiempo de ejecución. bookworm todavía tiene
# el libaio1 clásico.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libaio1 \
    unzip \
    wget \
    netcat-openbsd \
    libzip-dev \
    libonig-dev \
    zlib1g-dev \
    && docker-php-ext-install pdo mbstring zip \
    && rm -rf /var/lib/apt/lists/*

# ── Oracle Instant Client + extensión oci8 ─────────────────────
# Basic Light (runtime) + SDK (headers, necesarios para compilar oci8).
# Descarga directa de Oracle, sin autenticación (Instant Client es de
# distribución libre bajo la licencia OTN).
#
# Soporta amd64 (23.4 fijada) y arm64 (VM Ampere A1 de Oracle Cloud, donde el
# cliente se descarga con la URL generica "latest" porque Oracle no publica la
# 23.4 para ARM). El cliente se deja siempre en /opt/oracle/instantclient,
# sin importar el numero de version, y los symlinks se resuelven por glob.
ENV ORACLE_HOME=/opt/oracle/instantclient
RUN mkdir -p /opt/oracle && cd /opt/oracle \
    && if [ "$(dpkg --print-architecture)" = "arm64" ]; then \
         BASE=https://download.oracle.com/otn_software/linux/instantclient; \
         wget -nv $BASE/instantclient-basiclite-linux-arm64.zip -O basiclite.zip; \
         wget -nv $BASE/instantclient-sdk-linux-arm64.zip -O sdk.zip; \
       else \
         BASE=https://download.oracle.com/otn_software/linux/instantclient/2340000; \
         wget -nv $BASE/instantclient-basiclite-linux.x64-23.4.0.24.05.zip -O basiclite.zip; \
         wget -nv $BASE/instantclient-sdk-linux.x64-23.4.0.24.05.zip -O sdk.zip; \
       fi \
    && unzip -oq basiclite.zip && unzip -oq sdk.zip \
    && rm -f *.zip \
    && mv instantclient_* instantclient \
    && cd instantclient \
    && ln -sf $(ls libclntsh.so.* | head -n1) libclntsh.so \
    && ln -sf $(ls libocci.so.* | head -n1) libocci.so \
    && echo "$ORACLE_HOME" > /etc/ld.so.conf.d/oracle-instantclient.conf \
    && ldconfig

RUN echo "instantclient,$ORACLE_HOME" | pecl install oci8 \
    && docker-php-ext-enable oci8

# ── Composer ──────────────────────────────────────────────────
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# ── Dependencias PHP ──────────────────────────────────────────
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-scripts

# ── Código fuente ─────────────────────────────────────────────
COPY backend/ .

# ── Página de estado de PHP-FPM (la lee php-fpm_exporter) ─────
COPY docker/php-fpm-status.conf /usr/local/etc/php-fpm.d/zz-status.conf

# ── Script de inicio: lanza stunnel (mTLS server, si hay certs) + PHP-FPM ──
COPY docker/entrypoint-backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 9000 9443

HEALTHCHECK --interval=30s --timeout=5s \
  CMD nc -z localhost 9000 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
