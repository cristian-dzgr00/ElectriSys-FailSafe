APP_ENV=development

# Oracle Database 23ai Free — instancia única (ver oracle/docs/migracion-oracle.md).
# Bajo docker-compose, DB_HOST=oracle-db (nombre del servicio); fuera de
# Docker, localhost y el puerto que hayas mapeado.
DB_HOST=oracle-db
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_USER=electrisys
DB_PASS=ElectriOra_2026!

# OJO: bajo docker-compose, JWT_SECRET, WS_NOTIFY_KEY y NLP_INTERNAL_KEY
# se toman de docker/.env y PISAN lo que pongas aquí — así el backend, el
# websocket-server y el nlp-service comparten el mismo valor sí o sí.
# Los de este archivo se usan al correr el backend fuera de Docker
# (php -S, según "Desarrollo local sin Docker" en el README).
JWT_SECRET=electrisys_jwt_secret_2024_super_seguro
JWT_EXPIRY=28800
JWT_EXPIRATION=28800

FRONTEND_URL=http://localhost

# WebSocket Server — clave interna PHP → WS Server
WS_NOTIFY_KEY=ws_internal_notify_key

# Carpeta donde Data Pump deja los respaldos, vista desde el backend.
# Bajo docker-compose.backup.yml el volumen se monta de solo lectura en
# esta ruta; se usa solo para LISTAR los .dmp en /api/admin/backups.
BACKUP_PATH=/opt/oracle/backups/electrisys

# Microservicio NLP (asistente de recomendación de repuestos)
# NLP_SERVICE_URL: en docker-compose, http://nlp-service:8000. Fuera de
# Docker (dev local), apunta al puerto donde corras `uvicorn app.main:app`.
NLP_SERVICE_URL=http://nlp-service:8000
NLP_INTERNAL_KEY=nlp_internal_key_2024
