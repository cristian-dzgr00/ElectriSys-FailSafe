{
    "name": "electrisys/backend",
    "description": "ElectriSys POS - Backend PHP con Slim Framework",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "firebase/php-jwt": "^6.9",
        "vlucas/phpdotenv": "^5.5",
        "selective/basepath": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "audit": {
            "abandoned": "ignore",
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "Ignorado para desarrollo"
            }
        }
    }
}
